<?xml version="1.0" encoding="utf-8"?>
<!--
    :backup library manifest. Under AGP 8 the namespace comes from build.gradle.kts, so no package
    attribute is needed here.

    RestoreSwapInitializer registration (Plan 04, RST-03): androidx.startup discovers Initializers
    through a single merged InitializationProvider. We contribute our Initializer as a <meta-data>
    entry on that provider with tools:node="merge", so it merges into the app's InitializationProvider
    at build time and runs at cold start (before Application.onCreate / before Room opens the DB).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="io.github.ygaray.backupengine.startup.RestoreSwapInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>
